# Required for AI features (analysis, templates, Ask). Server-side only, never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional. Default: llama-3.3-70b-versatile. Use llama-3.1-8b-instant on Groq's free tier if you hit rate limits.
GROQ_MODEL=

# Optional persistence. Without these the app stores highlights/imports in ./.data (local) or /tmp (serverless).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
